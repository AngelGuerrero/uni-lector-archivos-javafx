<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="0.0" prefWidth="620.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unadm.lector.controller.PreferencesController"
      styleClass="panel-dialogo">

  <children>

    <VBox spacing="2.0" styleClass="cabecera-dialogo">
      <padding><Insets bottom="12.0" left="18.0" right="18.0" top="14.0"/></padding>
      <children>
        <Label text="Preferencias" styleClass="titulo-dialogo"/>
        <Label text="Los cambios se ven al momento. Cancelar deja todo como estaba."
               styleClass="subtitulo-dialogo"/>
      </children>
    </VBox>

    <Separator/>

    <VBox spacing="16.0">
      <padding><Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/></padding>
      <children>

        <Label text="Apariencia" styleClass="titulo-seccion"/>
        <GridPane hgap="14.0" vgap="10.0">
          <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150.0"/>
            <ColumnConstraints minWidth="200.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
          </columnConstraints>
          <children>
            <Label text="Tema:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cbTema" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Tipografia del editor:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbFuente" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Tamano:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Spinner fx:id="spTamano" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
          </children>
        </GridPane>

        <TextArea fx:id="txtMuestra" prefRowCount="3" editable="false" wrapText="false"
                  styleClass="muestra-fuente"/>

        <Separator/>

        <Label text="Editor" styleClass="titulo-seccion"/>
        <VBox spacing="8.0">
          <children>
            <CheckBox fx:id="chkAjusteLinea" text="Ajustar las lineas largas al ancho de la ventana"/>
            <CheckBox fx:id="chkNumerosLinea" text="Mostrar numeros de linea"/>
            <Label styleClass="nota" wrapText="true"
                   text="Los numeros de linea se ocultan mientras el ajuste de linea esta activo, porque una linea del archivo pasa a ocupar varios renglones."/>
          </children>
        </VBox>

        <Separator/>

        <Label text="Archivos" styleClass="titulo-seccion"/>
        <GridPane hgap="14.0" vgap="10.0">
          <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150.0"/>
            <ColumnConstraints minWidth="200.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
          </columnConstraints>
          <children>
            <Label text="Codificacion por omision:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cbCodificacion" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Archivos recientes:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Spinner fx:id="spRecientes" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
          </children>
        </GridPane>

        <CheckBox fx:id="chkDetectarCodificacion"
                  text="Detectar la codificacion automaticamente al abrir"/>
        <Label styleClass="nota" wrapText="true"
               text="Con la deteccion activa se respeta la marca de orden de bytes y se prueba UTF-8; si el archivo no es UTF-8 valido se usa la codificacion por omision."/>

        <Separator/>

        <VBox spacing="3.0">
          <children>
            <Label text="Las preferencias se guardan en:" styleClass="nota"/>
            <Label fx:id="lblRutaConfig" styleClass="nota-ruta" wrapText="true"/>
          </children>
        </VBox>

      </children>
    </VBox>

    <Separator/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
      <padding><Insets bottom="14.0" left="18.0" right="18.0" top="12.0"/></padding>
      <children>
        <Button text="Restaurar valores" onAction="#restaurarValores"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#cancelar" cancelButton="true"/>
        <Button text="Aceptar" onAction="#aceptar" defaultButton="true" styleClass="boton-primario"/>
      </children>
    </HBox>

  </children>
</VBox>
