<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="12.0" prefWidth="600.0" minWidth="560.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unadm.lector.controller.FindReplaceController"
      styleClass="panel-dialogo">

  <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>

  <children>

    <GridPane hgap="10.0" vgap="10.0">
      <columnConstraints>
        <ColumnConstraints halignment="RIGHT" minWidth="90.0"/>
        <ColumnConstraints hgrow="ALWAYS"/>
      </columnConstraints>
      <rowConstraints>
        <RowConstraints/>
        <RowConstraints/>
      </rowConstraints>
      <children>
        <Label text="Buscar:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtBuscar" promptText="Texto a buscar"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Reemplazar:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtReemplazar" promptText="Texto de reemplazo"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
      </children>
    </GridPane>

    <FlowPane hgap="16.0" vgap="8.0">
      <children>
        <CheckBox fx:id="chkMayusculas" text="Distinguir mayusculas"/>
        <CheckBox fx:id="chkPalabraCompleta" text="Palabra completa"/>
        <CheckBox fx:id="chkRegex" text="Expresion regular"/>
        <CheckBox fx:id="chkCircular" text="Buscar en ciclo" selected="true"/>
      </children>
    </FlowPane>

    <Label fx:id="lblResultado" styleClass="resultado-busqueda" wrapText="true" minHeight="20.0"/>

    <!-- minWidth="-Infinity" equivale a USE_PREF_SIZE: sin el, el HBox encoge
         los botones hasta dejar las etiquetas en "Reem...". -->
    <HBox spacing="8.0" alignment="CENTER_LEFT">
      <children>
        <Button text="Anterior" onAction="#buscarAnterior" minWidth="-Infinity"/>
        <Button text="Siguiente" onAction="#buscarSiguiente" defaultButton="true"
                minWidth="-Infinity" styleClass="boton-primario"/>
        <Button text="Contar" onAction="#contar" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS" minWidth="10.0"/>
        <Button text="Reemplazar" onAction="#reemplazar" minWidth="-Infinity"/>
        <Button text="Reemplazar todo" onAction="#reemplazarTodo" minWidth="-Infinity"/>
      </children>
    </HBox>

    <HBox alignment="CENTER_RIGHT">
      <children>
        <Button text="Cerrar" onAction="#cerrar" cancelButton="true"/>
      </children>
    </HBox>

  </children>
</VBox>
